CREATE TABLE hotel_amenity_association (
	hotel_id INTEGER NOT NULL, 
	amenity_id INTEGER NOT NULL, 
	CONSTRAINT pk_hotel_amenity_association PRIMARY KEY (hotel_id, amenity_id), 
	CONSTRAINT uq_hotel_amenity UNIQUE (hotel_id, amenity_id), 
	CONSTRAINT fk_hotel_amenity_association_hotel_id_hotels FOREIGN KEY(hotel_id) REFERENCES hotels (id), 
	CONSTRAINT fk_hotel_amenity_association_amenity_id_amenities FOREIGN KEY(amenity_id) REFERENCES amenities (id)
)


